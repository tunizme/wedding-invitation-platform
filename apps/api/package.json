{
  "name": "@wedding/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "build": "nest build",
    "format": "prettier --write src test",
    "format:check": "prettier --check src test",
    "lint": "eslint src test --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner --project unit",
    "test:integration": "vitest run --configLoader runner --project integration",
    "test:contract": "vitest run --configLoader runner --project contract",
    "test:iam": "vitest run --configLoader runner --project unit --project contract --project integration identity-access",
    "bootstrap:admin": "ts-node src/modules/identity-access/admin/bootstrap-admin.command.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate src/infrastructure/database/migrations/Generated -d src/infrastructure/database/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infrastructure/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/infrastructure/database/data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/infrastructure/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/jwt": "12.0.2",
    "argon2": "0.45.1",
    "google-auth-library": "11.1.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.0.10",
    "resend": "6.28.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.0.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "9.0.10",
    "@types/nodemailer": "8.0.2",
    "@apidevtools/swagger-parser": "13.1.0",
    "ajv": "8.18.0",
    "ajv-formats": "3.0.1",
    "js-yaml": "4.3.2",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
