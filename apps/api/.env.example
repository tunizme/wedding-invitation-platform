# Required server-only configuration
DATABASE_URL=postgresql://wedding_local:local-development-only@127.0.0.1:5432/wedding_local
FRONTEND_ORIGIN=http://localhost:3000

# Optional
NODE_ENV=development
API_PORT=3001
DATABASE_HEALTH_TIMEOUT_MS=1000

# IAM keys are server-only and must be supplied before ordinary API startup.
# For disposable local/CI sessions (keys lost on restart):
# node apps/api/scripts/with-test-iam.cjs pnpm dev:api
API_PUBLIC_ORIGIN=http://localhost:3001
IAM_JWT_ISSUER=http://localhost:3001
IAM_JWT_AUDIENCE=wedding-web
IAM_JWT_KID=local-1
IAM_JWT_PRIVATE_KEY=
IAM_JWT_PUBLIC_KEYS=
IAM_KEY_VERSION=1
# JSON maps: version -> base64-encoded 32-byte random key. Keep previous versions during rotation.
IAM_REFRESH_KEYS=
IAM_CSRF_KEYS=
IAM_ENCRYPTION_KEYS=
IAM_RATE_KEYS=
IAM_GOOGLE_ENABLED=false
# IAM_GOOGLE_CLIENT_ID=
# IAM_GOOGLE_CLIENT_SECRET=
IAM_FACEBOOK_ENABLED=false
# IAM_FACEBOOK_CLIENT_ID=
# IAM_FACEBOOK_CLIENT_SECRET=
# Facebook adapter pins Meta Graph API v26.0; verify support before upgrading.
# Local capture only; production requires resend plus an authorized sender and send-only key.
IAM_EMAIL_TRANSPORT=smtp
IAM_EMAIL_FROM=no-reply@wedding.test
IAM_SMTP_HOST=127.0.0.1
IAM_SMTP_PORT=1025
# IAM_RESEND_API_KEY=
# Enabling a provider also requires IAM_<PROVIDER>_CLIENT_ID and IAM_<PROVIDER>_CLIENT_SECRET.
# IAM_RATE_<ACTION> may tighten (1..default) the defaults in identity-access.environment.ts.
# IAM_TTL_ACCESS=900, SESSION=1209600, OAUTH=600, ONBOARDING=1800,
# VERIFICATION=86400 and RESET=1800 are fixed by the approved contract.
# Retention defaults: batch 1000; OAuth/rate bucket 24h; expired onboarding 7d;
# completed onboarding/challenge/session/outbox 30d; Admin audit 730d.
# IAM_RETENTION_* may only be changed within the validated bounds in
# identity-access.environment.ts. Audit changes require privacy/legal review.

# Private object storage. Provision explicitly with pnpm builder:storage:init.
# MinIO root credentials belong only to the root infrastructure .env.
BUILDER_S3_ENDPOINT=http://127.0.0.1:9000
BUILDER_S3_REGION=us-east-1
BUILDER_S3_BUCKET=wedding-builder-development
BUILDER_S3_PREFIX=development/
BUILDER_S3_FORCE_PATH_STYLE=true
BUILDER_S3_ACCESS_KEY_ID=wedding-builder-dev
BUILDER_S3_SECRET_ACCESS_KEY=
# AWS: omit endpoint and BOTH static keys to use an IAM role; set path style false.
# BUILDER_S3_SESSION_TOKEN= (only with both explicit temporary keys)
BUILDER_RENDER_ORIGIN=http://127.0.0.1:3000
# Generate separately from IAM keys: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BUILDER_RATE_HMAC_KEY=

# Disposable integration tests only. All six are required, no dev fallback.
BUILDER_TEST_S3_ENDPOINT=http://127.0.0.1:9000
BUILDER_TEST_S3_REGION=us-east-1
BUILDER_TEST_S3_BUCKET=wedding-builder-test
BUILDER_TEST_S3_ACCESS_KEY_ID=wedding-builder-test
BUILDER_TEST_S3_SECRET_ACCESS_KEY=
BUILDER_TEST_S3_FORCE_PATH_STYLE=true
# Runner creates tests/<uuid>/ and clears inherited session tokens in child env.
# BUILDER_TEST_DATABASE_URL=postgresql://.../disposable_test_database
